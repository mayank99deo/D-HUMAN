# Copy to .env.local for local development, and add the same values in your host (e.g. Vercel).

# Public URL of the site, used for share previews and email links and images.
# Optional on Vercel: when empty, the project's production domain is used
# (d-human.vercel.app now, dhuman.fit once that domain is added to the project).
NEXT_PUBLIC_SITE_URL=

# Google Sheets: the web app URL from google-apps-script/Code.gs (Deploy > Web app).
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Any long random string. Must match WEBHOOK_SECRET in the Apps Script project's Script properties.
# Generate one with: openssl rand -hex 32
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys). Leave empty to skip emails while testing.
RESEND_API_KEY=
# Sender address. dhuman.fit is verified in Resend; this is also the default.
RESEND_FROM="D-Human <hello@dhuman.fit>"
# Optional: where replies to the welcome email go.
RESEND_REPLY_TO=
# Optional: Resend segment ID that new signups join, for launch Broadcasts.
RESEND_SEGMENT_ID=

# ── Platform (sign-in, reports, food, stacks) ──
# Postgres connection string. Leave empty locally to use the embedded database in .data/.
DATABASE_URL=
# Claude, for reading reports and meals, finding events, wraps and stacks.
ANTHROPIC_API_KEY=
# Optional. Each job has a default model (lib/ai/client.ts): Haiku 5.5 to read
# values off reports, meals and wraps; Sonnet 5.5 for the read, events and stacks.
# CLAUDE_MODEL switches every job at once; CLAUDE_MODEL_EXTRACT, _READ, _FOOD,
# _WRAP, _EVENTS or _STACK switch one (e.g. claude-opus-5-5 for the read).
CLAUDE_MODEL=
# Keys the sign-in code hashes. Required in production: openssl rand -hex 32
AUTH_SECRET=
# Local only: 1 = illustrative AI results when there's no ANTHROPIC_API_KEY.
D_HUMAN_AI_MOCK=
