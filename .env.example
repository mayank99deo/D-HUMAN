# Copy to .env.local for local development, and add the same values in your host (e.g. Vercel).

# Public URL of the site. Used for share previews and the logo in emails.
NEXT_PUBLIC_SITE_URL=https://dhuman.fit

# Google Sheets: the web app URL from google-apps-script/Code.gs (Deploy > Web app).
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Any long random string. Must match WEBHOOK_SECRET in the Apps Script project's Script properties.
# Generate one with: openssl rand -hex 32
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys). Leave empty to skip emails while testing.
RESEND_API_KEY=
# Must use a domain verified in Resend. Until dhuman.fit is verified, Resend only
# delivers from onboarding@resend.dev to your own account's email address.
RESEND_FROM="D-Human <hello@dhuman.fit>"
# Optional: where replies to the welcome email go.
RESEND_REPLY_TO=
# Optional: Resend segment ID that new signups join, for launch Broadcasts.
RESEND_SEGMENT_ID=
